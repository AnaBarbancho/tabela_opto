{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabela de Optotipos",
  "version": "0.1.0",
  "identifier": "com.victorow.tabelaopto",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sistema de Optotipos Snellen",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
